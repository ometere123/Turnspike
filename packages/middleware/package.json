{
  "name": "@turnspike-qie/middleware",
  "version": "0.2.0",
  "description": "Express middleware that charges per request in QUSDC on QIE through the Turnspike allowance contract.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./challenge": {
      "types": "./dist/challenge.d.ts",
      "default": "./dist/challenge.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "ethers": "^6.13.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ometere123/Turnspike.git",
    "directory": "packages/middleware"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://turnspike-qie.vercel.app/developers",
  "keywords": [
    "qie",
    "qusdc",
    "http-402",
    "payments",
    "agents",
    "turnspike"
  ]
}
